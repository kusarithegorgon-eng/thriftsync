VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your-emailjs-contact-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# PayMongo — this app uses Vite, so the publishable key is VITE_PAYMONGO_PUBLIC_KEY (not NEXT_PUBLIC_).
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
# Optional UI for the non-payment GCash demo. It is shown only with a PayMongo test key
# and also requires GCASH_SIMULATION_ENABLED=true on the Supabase Edge Function.
VITE_GCASH_SIMULATION_ENABLED=false

# STRICTLY server-side (Edge Functions / Express). Never prefix with VITE_ or NEXT_PUBLIC_.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
# Seller order email notifications use a dedicated EmailJS template. Set these as
# Supabase Edge Function secrets (not Vite variables).
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_ORDER_TEMPLATE_ID=your-emailjs-order-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
GCASH_SIMULATION_ENABLED=false
# Optional Thrift Crawl routing provider; set as a Supabase Edge Function secret.
GOOGLE_MAPS_API_KEY=your-google-routes-api-key
