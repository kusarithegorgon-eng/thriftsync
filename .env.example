VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your-emailjs-contact-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# PayMongo — this app uses Vite, so the publishable key is VITE_PAYMONGO_PUBLIC_KEY (not NEXT_PUBLIC_).
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here

# STRICTLY server-side (Edge Functions / Express). Never prefix with VITE_ or NEXT_PUBLIC_.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
