# MariaDB connection used by the ThriftSync API.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=thrifysync
API_PORT=4000

# Replace this with a private random value of at least 32 characters.
AUTH_TOKEN_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
